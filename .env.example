# ---------- Server ----------
PORT=3000
# Timezone used for "today", OPD end time and per-hour stats
APP_TIMEZONE=Asia/Karachi

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require
# Cloud databases (Neon, Supabase...) need SSL (default). For a local PostgreSQL set this to false
# DB_SSL=false

# ---------- Auth ----------
JWT_SECRET=your_jwt_secret_key_here
# JWT_EXPIRES_IN=7d

# ---------- Email (Gmail app password) - used for OTP + password reset ----------
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password_here

# ---------- Queue behaviour (optional, defaults shown) ----------
# Send the "your turn is near" notification when this many patients are ahead
NOTIFY_WHEN_AHEAD=2
# Used for wait estimates until a doctor has real data (minutes)
DEFAULT_CONSULT_MINUTES=10
MAX_ADVANCE_BOOKING_DAYS=7
MAX_FAMILY_MEMBERS=10

# ---------- Push notifications via FCM (optional) ----------
# Download the service-account JSON from Firebase Console > Project settings > Service accounts.
# Without it push is skipped; in-app notifications + live WebSocket updates still work.
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# or paste the whole JSON on one line (handy for Render / Railway):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------- AI department guide (optional) ----------
# Without a key the guide uses a built-in keyword matcher.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
